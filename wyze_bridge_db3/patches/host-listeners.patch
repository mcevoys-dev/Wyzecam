+// safeRTSPListen accepts only a single IPv4 and TCP 8554.
+// go2rtc skips RTSP authentication for connections from 127.0.0.1, so
+// loopback is rejected. 0.0.0.0 would publish the stream on every host
+// interface, including Home Assistant Core's localhost. Core's own
+// go2rtc already uses 127.0.0.1:18554, and its API uses port 11984.
+// 172.30.32.0/23 is the hassio docker network, not the camera LAN.
+// Any other value disables the RTSP server.
+func safeRTSPListen(raw string) string {
+	host, port, err := net.SplitHostPort(strings.TrimSpace(raw))
+	if err != nil || port != "8554" {
+		return ""
+	}
+	ip := net.ParseIP(host).To4()
+	if ip == nil || ip.IsLoopback() || ip.IsUnspecified() || ip.IsLinkLocalUnicast() || ip.IsMulticast() {
+		return ""
+	}
+	if ip[0] == 172 && ip[1] == 30 && (ip[2] == 32 || ip[2] == 33) {
+		return ""
+	}
+	return net.JoinHostPort(ip.String(), port)
+}
