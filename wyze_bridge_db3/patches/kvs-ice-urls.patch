+
+// DescribeSource asks go2rtc to dial the stream and reports producer
+// state. The error text is scrubbed of URL queries and userinfo.
+func (c *APIClient) DescribeSource(ctx context.Context, name string) (string, error) {
+	probeCtx, cancel := context.WithTimeout(ctx, 25*time.Second)
+	defer cancel()
+	u := fmt.Sprintf("%s/api/streams?src=%s&video=all&audio=all", c.baseURL, url.QueryEscape(name))
+	req, err := http.NewRequestWithContext(probeCtx, "GET", u, nil)
+	if err != nil {
+		return "", err
+	}
+	client := &http.Client{Timeout: 25 * time.Second}
+	resp, err := client.Do(req)
+	if err != nil {
+		return "unreachable", fmt.Errorf("%s", RedactLog(err.Error()))
+	}
+	defer resp.Body.Close()
+	body, _ := io.ReadAll(io.LimitReader(resp.Body, 8192))
+	if resp.StatusCode != http.StatusOK {
+		return "dial-failed", fmt.Errorf("%s", RedactLog(strings.TrimSpace(string(body))))
+	}
+	info := decodeProbe(name, body)
+	connected := 0
+	bytes := 0
+	for _, prod := range info.Producers {
+		if prod.Connected() {
+			connected++
+		}
+		bytes += prod.Bytes()
+	}
+	return fmt.Sprintf("producers=%d connected=%d bytes=%d", len(info.Producers), connected, bytes), nil
+}
+
+func decodeProbe(name string, body []byte) StreamInfo {
+	var one StreamInfo
+	if err := json.Unmarshal(body, &one); err == nil && (one.Producers != nil || one.Consumers != nil) {
+		one.Name = name
+		return one
+	}
+	var many map[string]*StreamInfo
+	if err := json.Unmarshal(body, &many); err == nil {
+		if info := many[name]; info != nil {
+			info.Name = name
+			return *info
+		}
+	}
+	return StreamInfo{Name: name}
+}
+
+var (
+	reQuery   = regexp.MustCompile(`\?[^\s"]+`)
+	reUserinf = regexp.MustCompile(`://[^/\s:@]+:[^/\s@]+@`)
+)
+
+// RedactLog removes URL queries and userinfo so a KVS token or TURN
+// credential cannot land in the add-on log.
+func RedactLog(s string) string {
+	s = reUserinf.ReplaceAllString(s, "://")
+	s = reQuery.ReplaceAllString(s, "?redacted")
+	if len(s) > 300 {
+		s = s[:300]
+	}
+	return s
+}
--- a/internal/go2rtcmgr/redact_test.go
+++ b/internal/go2rtcmgr/redact_test.go
@@ -0,0 +1,22 @@
+package go2rtcmgr
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRedactLog(t *testing.T) {
+	in := "dial wss://user:secret@v.kinesisvideo.amazonaws.com/path?X-Amz-Security-Token=abc&token=def failed"
+	got := RedactLog(in)
+	for _, secret := range []string{"secret", "abc", "def", "user:secret"} {
+		if strings.Contains(got, secret) {
+			t.Fatalf("redact kept %q in %q", secret, got)
+		}
+	}
+	if !strings.Contains(got, "kinesisvideo.amazonaws.com") {
+		t.Fatalf("redact dropped the host: %q", got)
+	}
+	if !strings.Contains(got, "?redacted") {
+		t.Fatalf("query was not replaced: %q", got)
+	}
+}
