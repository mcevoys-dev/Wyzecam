+}
+
+// ReceiverInfo is one producer track's byte counter.
+type ReceiverInfo struct {
+	Bytes int `json:"bytes,omitempty"`
+}
+
+// Connected reports a producer go2rtc has dialed, not only registered.
+func (p ProducerInfo) Connected() bool {
+	return p.RemoteAddr != "" || len(p.Receivers) > 0 || p.BytesRecv > 0
+}
+
+// Bytes is media delivered on this producer.
+func (p ProducerInfo) Bytes() int {
+	n := p.BytesRecv
+	for _, r := range p.Receivers {
+		n += r.Bytes
+	}
+	return n
 }
 
