 // ProducerInfo describes a stream producer (source).
 type ProducerInfo struct {
-	URL    string        `json:"url,omitempty"`
-	Medias []interface{} `json:"medias,omitempty"`
+	URL        string         `json:"url,omitempty"`
+	Source     string         `json:"source,omitempty"`
