+func mediaSummary(body []byte) string {
+	var raw any
+	if err := json.Unmarshal(body, &raw); err != nil {
+		return ""
+	}
+	var parts []string
+	var walk func(any)
+	walk = func(v any) {
+		switch t := v.(type) {
+		case map[string]any:
+			if medias, ok := t["medias"].([]any); ok {
+				for _, media := range medias {
+					if s, ok := media.(string); ok && s != "" {
+						parts = append(parts, s)
+					}
+				}
+			}
+			for _, child := range t {
+				walk(child)
+			}
+		case []any:
+			for _, child := range t {
+				walk(child)
+			}
+		}
+	}
+	walk(raw)
+	seen := map[string]bool{}
+	out := make([]string, 0, len(parts))
+	for _, part := range parts {
+		if seen[part] {
+			continue
+		}
+		seen[part] = true
+		out = append(out, part)
+		if len(out) == 8 {
+			break
+		}
+	}
+	return strings.Join(out, "; ")
 }
 
