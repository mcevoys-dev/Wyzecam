+func TestFilter_MatchedNameOnly(t *testing.T) {
+	cams := append(makeCams(), wyzeapi.CameraInfo{Nickname: "Side door", Model: "WYZEDB3", MAC: "AABB44"})
+	f := &Filter{Names: []string{"SIDE DOOR"}}
