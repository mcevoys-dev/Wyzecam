+
+func TestFilter_TwoExactNames(t *testing.T) {
+	cams := append(makeCams(),
+		wyzeapi.CameraInfo{Nickname: "Side door", Model: "WYZEDB3", MAC: "AABB44"},
+		wyzeapi.CameraInfo{Nickname: "Garage Rear", Model: "LD_CFP", MAC: "AABB55"},
+	)
+	f := &Filter{Names: []string{"SIDE DOOR", "GARAGE REAR"}}
+	result := f.Apply(cams)
+	if len(result) != 2 {
+		t.Fatalf("two exact names returned %d cameras", len(result))
+	}
+	got := map[string]bool{}
+	for _, cam := range result {
+		got[cam.Nickname] = true
+	}
+	if !got["Side door"] || !got["Garage Rear"] {
+		t.Fatalf("two exact names returned %#v", result)
+	}
+}
