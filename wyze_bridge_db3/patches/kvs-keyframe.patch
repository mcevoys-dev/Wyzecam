+
+// logKVSNegotiation records the answer's media directions and codec
+// names. The SDP text and the signaling URL are not logged.
+func logKVSNegotiation(prod *webrtc.Conn) {
+	parts := make([]string, 0, len(prod.Medias))
+	for _, media := range prod.Medias {
+		if media == nil {
+			continue
+		}
+		parts = append(parts, media.String())
+	}
+	log.Info().Strs("medias", parts).Msg("[webrtc] kvs negotiated")
+	go func() {
+		time.Sleep(2 * time.Second)
+		bytes := prod.Recv
+		ev := log.Info()
+		if bytes == 0 {
+			ev = log.Warn()
+		}
+		ev.Int("bytes", bytes).Strs("medias", parts).Msg("[webrtc] kvs bytes")
+	}()
+}
